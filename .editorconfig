# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4
# rustfmt 负责真正的排版，这里只兜住基础规则
max_line_length = 100

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
# Markdown 里用两个空格结尾表示换行，别被自动删除
trim_trailing_whitespace = false

[*.{out,txt}]
insert_final_newline = true
trim_trailing_whitespace = false
